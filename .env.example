# Referencia local: reemplaza todos los valores ficticios en tu gestor de secretos.
# No copies valores reales a Git ni a Flutter.
SPRING_PROFILES_ACTIVE=development
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/foodies_db?sslMode=DISABLED
SPRING_DATASOURCE_USERNAME=local_test_user
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_TEST_PASSWORD
APP_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
APP_FLYWAY_ENABLED=false
APP_SEED_MODERATOR_ENABLED=false
APP_SEED_MODERATOR_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_TEST_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_TEST_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_TEST_API_SECRET
SPRING_MAIL_USERNAME=REPLACE_WITH_TEST_MAIL_ADDRESS
SPRING_MAIL_PASSWORD=REPLACE_WITH_TEST_MAIL_PASSWORD
